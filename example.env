# ─── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=put later
CLIENT_ID=1516313619476779120
OWNER_IDS=1244215702345482301

# Neon PostgreSQL (required for persistent storage across redeploys)
DATABASE_URL=
NEON_POOL_MAX=5

# ─── Sharding ─────────────────────────────────────────────────────────────────
# FIX: Shard count is now configurable (was hardcoded to 4).
# Use 'auto' to let Discord determine the optimal number.
TOTAL_SHARDS=auto
SHARDS_PER_CLUSTER=2

# ─── Bot Settings ─────────────────────────────────────────────────────────────
PREFIX=.
SUPPORT_SERVER_URL=https://discord.gg/Ehmqr5drSz
STATUS_TEXT=.help | LC
STATUS_TYPE=online
NODE_ENV=production
DEBUG=false

# ─── Assets (Optional — fallback images) ─────────────────────────────────────
DEFAULT_THUMBNAIL=
HELP_THUMBNAIL=
BANNER_URL=

# ─── Webhook Logging (Optional) ───────────────────────────────────────────────
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_USERNAME=Bot Logger
WEBHOOK_AVATAR_URL=
WEBHOOK_INFO_ENABLED=true
WEBHOOK_SUCCESS_ENABLED=true
WEBHOOK_WARNING_ENABLED=true
WEBHOOK_ERROR_ENABLED=true
WEBHOOK_DEBUG_ENABLED=false

# ─── LightCore Music (Lavalink v4) ───────────────────────────────────────────
MUSIC_ENABLED=true
MUSIC_DEFAULT_VOLUME=70
MUSIC_MAX_QUEUE=100
# Set either one node with LAVALINK_HOST/PORT/PASSWORD/SECURE, or multiple comma-separated entries:
# LAVALINK_NODES=host:port:password:true:primary,host2:2333:password2:false:backup
LAVALINK_HOST=
LAVALINK_PORT=2333
LAVALINK_PASSWORD=
LAVALINK_SECURE=false
LAVALINK_ID=main-node
