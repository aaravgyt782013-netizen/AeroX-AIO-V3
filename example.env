# ─── Required ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=put later
CLIENT_ID=1516313619476779120
OWNER_IDS=1244215702345482301

# Neon PostgreSQL (required for persistent storage across redeploys)
DATABASE_URL=
NEON_POOL_MAX=2

# ─── Sharding ─────────────────────────────────────────────────────────────────
# FIX: Shard count is now configurable (was hardcoded to 4).
# Use 'auto' to let Discord determine the optimal number.
TOTAL_SHARDS=auto
SHARDS_PER_CLUSTER=2

# ─── Bot Settings ─────────────────────────────────────────────────────────────
PREFIX=.
SUPPORT_SERVER_URL=https://discord.gg/4waqdE9AVZ
STATUS_TEXT=.help | LC
STATUS_TYPE=online
NODE_ENV=production
DEBUG=false

# ─── Assets (Optional — fallback images) ─────────────────────────────────────
DEFAULT_THUMBNAIL=
HELP_THUMBNAIL=
BANNER_URL=

# ─── Webhook Logging (Optional) ───────────────────────────────────────────────
WEBHOOK_ENABLED=false
WEBHOOK_URL=
WEBHOOK_USERNAME=Bot Logger
WEBHOOK_AVATAR_URL=
WEBHOOK_INFO_ENABLED=true
WEBHOOK_SUCCESS_ENABLED=true
WEBHOOK_WARNING_ENABLED=true
WEBHOOK_ERROR_ENABLED=true
WEBHOOK_DEBUG_ENABLED=false

# ─── LightCore Music (Lavalink v4) ───────────────────────────────────────────
MUSIC_ENABLED=true
MUSIC_DEFAULT_VOLUME=70
MUSIC_MAX_QUEUE=100

# Two Millohost nodes are configured automatically when credentials are supplied.
# Use the real Lavalink authorization password from your hosting panel; never commit it.
LAVALINK_PASSWORD=
# Optional: use separate passwords if the two nodes have different credentials.
LAVALINK_NODE_1_PASSWORD=
LAVALINK_NODE_2_PASSWORD=
# Optional node overrides (defaults are port 443 with TLS enabled).
LAVALINK_NODE_1_HOST=lava-v4.millohost.my.id
LAVALINK_NODE_1_PORT=443
LAVALINK_NODE_1_SECURE=true
LAVALINK_NODE_1_ID=millohost-primary
LAVALINK_NODE_2_HOST=lava4.millohost.my.id
LAVALINK_NODE_2_PORT=443
LAVALINK_NODE_2_SECURE=true
LAVALINK_NODE_2_ID=millohost-secondary

# Optional advanced override (up to two entries): host:port:password:true:id
# LAVALINK_NODES=host:443:password:true:primary,host2:443:password:true:secondary
